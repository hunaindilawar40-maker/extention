{
  "manifest_version": 3,
  "name": "Agnes Studio — text to video",
  "version": "1.0.0",
  "description": "Generate short AI videos from a prompt with the Agnes API, straight from your browser.",
  "action": {
    "default_title": "Agnes Studio",
    "default_popup": "web/index.html"
  },
  "host_permissions": [
    "https://apihub.agnes-ai.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
